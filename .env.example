DATABASE_URL=postgresql+asyncpg://oms:oms@localhost:5432/oms
REDIS_URL=redis://localhost:6379/0
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
PLATFORM_DOMAIN=platform.com
AUTO_CREATE_SCHEMA=true
WORKER_ENABLED=true
STOREFRONT_MODE=true
STORE_NAME=Sukha Goods
STORE_SLUG=sukha-goods
# Use a unique password (12+ characters) and a random session secret (32+ characters).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# false only for local HTTP. Set true for production HTTPS.
COOKIE_SECURE=false
PUBLIC_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# INR delivery fees by ISO country code. A "*" entry enables other countries.
SHIPPING_RATES={"IN":"0.00"}
SELLER_ADDRESS=
SUPPORT_EMAIL=
